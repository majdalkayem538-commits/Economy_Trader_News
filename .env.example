# ===== تلغرام =====
# من @BotFather
BOT_TOKEN=
# قناة المصدر بدون @
SOURCE_CHANNEL=ForexBreakingNews
# قناتك (البوت لازم يكون أدمن فيها بصلاحية نشر)
TARGET_CHANNEL=@your_channel
# رقمك على تلغرام: ابعت /start للبوت وبيقلك ياه. أكتر من واحد: 111,222
ADMIN_IDS=

# ===== قراءة المصدر =====
# web = من صفحة القناة العامة (بدون API ID) | userbot = من حسابك (فوري، بدو المفاتيح تحت)
SOURCE_MODE=web
# كل كم ثانية يشيك الصفحة (web)
POLL_SECONDS=20
# لـ userbot بس — من my.telegram.org و login.py
TG_API_ID=
TG_API_HASH=
TG_SESSION=

# ===== الذكاء الاصطناعي =====
# gemini أو deepseek
AI_PROVIDER=gemini
# من https://aistudio.google.com/apikey
GEMINI_API_KEY=
# بيجرب الأول، وإذا انلغى بيروح للتاني
GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# المراجع: ذكاء تاني بيدقق كل مسودة مقابل الخبر الأصلي
# all = كل الأخبار | high = الأخبار القوية 🔴 بس | off = مطفي
REVIEW_MODE=all
# deepseek (بدو DEEPSEEK_API_KEY) أو gemini (موديل تاني بنفس مفتاح Gemini)
REVIEW_PROVIDER=deepseek
REVIEW_MODEL=
# ثواني بين كل طلبين (المجاني تقريباً 10 بالدقيقة)
AI_MIN_INTERVAL_SEC=7

# ===== السلوك =====
HASHTAGS=#EconomyTrader #ايكونومي_تريدر
# true = ما تبعتلي الأخبار ضعيفة التأثير
SKIP_LOW_IMPACT=false
# false = بدون قسم السيناريوهات
SHOW_SCENARIOS=true
# بعد إعادة التشغيل: رجّع الأخبار اللي فاتت آخر كم دقيقة
CATCHUP_MINUTES=120
